{
  "manifest_schema_version": 3,
  "sdk_version": "5.13.1",
  "app_id": "goto-meeting-connector",
  "version": "0.1.0",
  "name": "GoTo Meeting",
  "description": "",
  "icon": "icon.svg",
  "actions_explicit": true,
  "system": false,
  "capabilities": [
    "gotomeeting:manage"
  ],
  "tools": [
    {
      "name": "connect_goto_meeting",
      "description": "Connect your own GoTo Meeting account by saving your OAuth Access Token.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "create:connection"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "label": {
            "default": "",
            "description": "Friendly connection label, e.g. Acme GoTo.",
            "title": "Label",
            "type": "string"
          },
          "access_token": {
            "description": "GoTo OAuth 2.0 Bearer Access Token.",
            "title": "Access Token",
            "type": "string"
          }
        },
        "required": [
          "access_token"
        ],
        "title": "ConnectGoToParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "id": {
            "description": "Connection ID",
            "title": "Id",
            "type": "string"
          },
          "label": {
            "description": "Connection label",
            "title": "Label",
            "type": "string"
          },
          "status": {
            "default": "connected",
            "description": "Connection status",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label"
        ],
        "title": "ConnectResult",
        "type": "object"
      },
      "event": "goto-meeting-connector.connect_goto_meeting",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tool_goto-meeting-connector_chat"
    },
    {
      "name": "list_connections",
      "description": "List connected GoTo Meeting accounts without exposing credentials.",
      "action_type": "read",
      "chain_callable": true,
      "effects": [],
      "id_projection": "",
      "params_schema": {
        "description": "Empty parameter model.",
        "properties": {},
        "title": "NoParams",
        "type": "object"
      },
      "return_schema": {
        "$defs": {
          "GoToConnection": {
            "properties": {
              "id": {
                "description": "Connection ID",
                "title": "Id",
                "type": "string"
              },
              "label": {
                "description": "Connection label",
                "title": "Label",
                "type": "string"
              },
              "created_at": {
                "description": "Connection timestamp",
                "title": "Created At",
                "type": "string"
              }
            },
            "required": [
              "id",
              "label",
              "created_at"
            ],
            "title": "GoToConnection",
            "type": "object"
          }
        },
        "properties": {
          "connections": {
            "items": {
              "$ref": "#/$defs/GoToConnection"
            },
            "title": "Connections",
            "type": "array"
          },
          "total": {
            "default": 0,
            "title": "Total",
            "type": "integer"
          }
        },
        "title": "ConnectionList",
        "type": "object"
      },
      "event": "",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tool_goto-meeting-connector_chat"
    },
    {
